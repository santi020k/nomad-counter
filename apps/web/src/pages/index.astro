---
import FaqSection from '@/components/home/FaqSection.astro'
import HeroSection from '@/components/home/HeroSection.astro'
import MainNav from '@/components/home/MainNav.astro'
import MarketingHighlights from '@/components/home/MarketingHighlights.astro'
import ProjectHistory from '@/components/home/ProjectHistory.astro'
import SEO from '@/components/SEO.astro'
import SiteFooter from '@/components/SiteFooter.astro'

import '@/styles/global.css'

export const prerender = true

const description = 'Nomad Counter is a retired travel-day tracking project. Explore its original design, inclusive day-counting approach, and archived source code.'
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Nomad Counter',
  url: 'https://nomad.santi020k.com/',
  description,
  creator: { '@type': 'Person', name: 'Santiago Molina', url: 'https://santi020k.com' }
}
---

<!doctype html>
<html lang="en">
  <head>
    <SEO title="Project archive" description={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-i18n="skipContent">Skip to content</a>
    <MainNav />
    <main id="main-content" class="shell app-shell">
      <HeroSection />
      <ProjectHistory />
      <MarketingHighlights />
      <FaqSection />
    </main>
    <SiteFooter />
  </body>
</html>
